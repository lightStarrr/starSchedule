<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络访问 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 通知权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 精确闹钟权限（Android 12+ 必须） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 接收开机广播权限 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-permission android:name="flyme.permission.READ_NOTIFICATION_LIVE_STATE" />

    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!-- 仅允许与主应用同签名的代理应用（wakeup-proxy）读取导出的课表数据 -->
    <permission
        android:name="com.star.schedule.permission.READ_SCHEDULE_EXPORT"
        android:protectionLevel="signature" />

    <queries>
        <package android:name="com.suda.yzune.wakeupschedule" />
        <provider android:authorities="com.suda.yzune.wakeupschedule.provider" />
    </queries>

    <application
        android:name=".app.ScheduleApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StarSchedule"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true">

        <!-- 由 ScheduleApplication 提供 WorkManager 配置，首次使用时按该配置初始化。 -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".app.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.StarSchedule" />
        <!-- 保留 .MainActivity 作为桌面入口别名，确保既有桌面图标与快捷方式升级后持续有效。 -->
        <activity-alias
            android:name=".MainActivity"
            android:targetActivity=".app.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.StarSchedule">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity
            android:name=".app.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.StarSchedule" />
        <activity
            android:name=".app.AiSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.StarSchedule" />
        <activity
            android:name=".app.NewAiProviderActivity"
            android:exported="false"
            android:theme="@style/Theme.StarSchedule" />
        <activity
            android:name=".app.AboutActivity"
            android:exported="false"
            android:theme="@style/Theme.StarSchedule" />
        <activity
            android:name=".app.SoftwareUpdateActivity"
            android:exported="false"
            android:theme="@style/Theme.StarSchedule" />
        <activity
            android:name=".app.DataSourcesActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.StarSchedule" />
        <activity
            android:name=".app.ReminderActivity"
            android:exported="false"
            android:theme="@style/Theme.StarSchedule" />
        <activity
            android:name=".app.TimetableSettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.StarSchedule" />
        <activity
            android:name=".app.NewTimetableActivity"
            android:exported="false"
            android:theme="@style/Theme.StarSchedule" />
        <activity
            android:name=".app.ManualCreateTimetableActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.StarSchedule" />
        <activity
            android:name=".app.WakeUpImportActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.StarSchedule" />
        <activity
            android:name=".app.SleepDownImportActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.StarSchedule" />
        <activity
            android:name=".app.RowHeightActivity"
            android:exported="false"
            android:theme="@style/Theme.StarSchedule" />
        <activity
            android:name=".app.LessonTimeSettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.StarSchedule" />
        <activity
            android:name=".app.LessonTimeTemplateActivity"
            android:exported="false"
            android:theme="@style/Theme.StarSchedule" />
        <activity
            android:name=".app.LessonTimeTemplateEditActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.StarSchedule" />
        <activity
            android:name=".app.CourseSettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.StarSchedule" />
        <activity
            android:name=".app.CourseEditActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.StarSchedule" />
        <activity
            android:name=".app.WallpaperActivity"
            android:exported="false"
            android:theme="@style/Theme.StarSchedule" />
        <activity
            android:name=".app.WallpaperPreviewActivity"
            android:exported="false"
            android:theme="@style/Theme.StarSchedule" />
        <activity
            android:name=".app.EmojiWallpaperActivity"
            android:exported="false"
            android:theme="@style/Theme.StarSchedule" />
        <!-- 崩溃页：独立进程，主进程崩掉后它还能正常显示 -->
        <activity
            android:name=".app.CrashActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:process=":crash"
            android:theme="@style/Theme.StarSchedule" />

        <!-- 课程提醒广播接收器 -->
        <receiver
            android:name=".platform.notification.receiver.CourseReminderReceiver"
            android:exported="false" />
        <receiver
            android:name=".platform.notification.receiver.CourseNotificationUpdateReceiver"
            android:exported="false" />
        <receiver
            android:name=".platform.notification.receiver.CourseNotificationCancelReceiver"
            android:exported="false" />

        <!-- 系统启动广播接收器 -->
        <receiver
            android:name=".platform.notification.receiver.BootCompletedReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".platform.widget.TwoDaysWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- 定期更新广播接收器 -->
        <receiver
            android:name=".platform.notification.receiver.DailyUpdateReceiver"
            android:enabled="true"
            android:exported="false" />

        <service
            android:name=".platform.notification.LiveNotification"
            android:exported="true">
            <intent-filter>
                <action android:name="com.android.systemui.LIVE_NOTIFICATION_SERVICE" />
            </intent-filter>

            <meta-data
                android:name="live_notification_config"
                android:resource="@xml/live_notification_config" />
        </service>

        <!-- JobScheduler服务 -->
        <service
            android:name=".platform.widget.WidgetUpdateJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="true" />

        <provider
            android:name=".platform.provider.ScheduleExportProvider"
            android:authorities="com.star.schedule.export"
            android:readPermission="com.star.schedule.permission.READ_SCHEDULE_EXPORT"
            android:enabled="true"
            android:exported="true" />

        <!-- 小组件定时更新广播接收器 -->
        <receiver
            android:name=".platform.widget.WidgetBootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>
    </application>

</manifest>
